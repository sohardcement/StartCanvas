<Window x:Class="WinTileLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinTileLauncher"
        xmlns:controls="clr-namespace:WinTileLauncher.Controls"
        xmlns:models="clr-namespace:WinTileLauncher.Models"
        Title="Tile10" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="#081A2E" Foreground="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <local:TileWidthConverter x:Key="TileWidth" />
        <local:TileHeightConverter x:Key="TileHeight" />
        <local:StringToBrushConverter x:Key="ColorBrush" />
        <local:TileAppearanceBrushConverter x:Key="TileAppearanceBrush" />
        <local:NullToVisibilityConverter x:Key="IconVisible" />
        <local:NullToInverseVisibilityConverter x:Key="GlyphVisible" />
        <local:ClockFontSizeConverter x:Key="ClockFontSize" />
        <local:DrawerWidthConverter x:Key="DrawerWidth" />

        <Style x:Key="ZoomResetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9FCFE8F8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#243E6680" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4EDDF3FF" />
                                <Setter Property="Foreground" Value="#E6F6FCFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3B5B8198" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#304D7894" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D9F5FCFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#62CFEFFF" />
            <Setter Property="BorderBrush" Value="#70F0FAFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome" Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect Color="#06111D" BlurRadius="8" ShadowDepth="1" Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#A0E4F6FF" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#D0F8FDFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#D0BDEAFF" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#F4FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#62CFEFFF" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border x:Name="Rail" Padding="1" Background="#18030F1D"
                                BorderBrush="#2A9ECBE3" BorderThickness="1" CornerRadius="6">
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Style="{StaticResource GlassScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                                <Setter TargetName="PART_Thumb" Property="MinHeight" Value="38" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PART_Thumb" Property="MinWidth" Value="38" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="Rail" Property="Background" Value="#30071A2D" />
                                <Setter TargetName="Rail" Property="BorderBrush" Value="#55BCE9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Margin" Value="3,2,1,2" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Margin" Value="2,3,2,1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AppListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome" Padding="2" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#265A7C96" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#3CCCEEFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#48406C8A" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#9ADAF3FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#DDF7FDFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemChrome" Property="Background" Value="#604A7C9B" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#D0EEFAFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerToggleStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="ToggleChrome" Padding="11,9" CornerRadius="7"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ToggleBox" Width="17" Height="17" CornerRadius="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#20172C40" BorderBrush="#A6D7EEFA" BorderThickness="1">
                                    <Path x:Name="ToggleCheck" Data="M 3,8 L 7,12 L 14,4"
                                          Stroke="White" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#285B7C96" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#3CCDEEFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBox" Property="Background" Value="#B22E88B8" />
                                <Setter TargetName="ToggleBox" Property="BorderBrush" Value="#E5EEFAFF" />
                                <Setter TargetName="ToggleCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleChrome" Property="Background" Value="#315B7C96" />
                                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#D8F5FCFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ActionChrome" Padding="{TemplateBinding Padding}" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="ActionAccent" Width="2" Height="18" CornerRadius="1"
                                        Background="#C6DDF5FF" HorizontalAlignment="Left" Opacity="0" />
                                <ContentPresenter Margin="5,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#315C819E" />
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="#52CDEEFF" />
                                <Setter TargetName="ActionAccent" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#4B3D789C" />
                                <Setter TargetName="ActionChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionChrome" Property="Background" Value="#315C819E" />
                                <Setter TargetName="ActionChrome" Property="BorderBrush" Value="#D8F5FCFF" />
                                <Setter TargetName="ActionAccent" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionChrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#42CDEEFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#F70B1D30" />
            <Setter Property="Foreground" Value="#F4FAFDFF" />
            <Setter Property="BorderBrush" Value="#668FC6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Padding="{TemplateBinding Padding}" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F4FAFDFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="218" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1"
                                          Stroke="#DDF7FFFF" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center" />
                                    <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M 1,1 L 5,5 L 1,9"
                                          Stroke="#A9DDF0FA" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Right" HorizontalOffset="-3" VerticalOffset="-6"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Padding="6" CornerRadius="9" Background="#FA0B1D30"
                                        BorderBrush="#789BCFE7" BorderThickness="1">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#3C4F7A98" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileMenuSeparatorStyle" TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#3F8FC6E2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileChromeStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#42E8F7FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#020A14" BlurRadius="18" ShadowDepth="5" Opacity="0.38" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B8F4FBFF" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000812" BlurRadius="24" ShadowDepth="7" Opacity="0.48" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#F2FAFEFF" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#4CCAF2FF" BlurRadius="20" ShadowDepth="0" Opacity="0.62" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type models:TileLayoutItem}">
            <Border x:Name="Tile" Style="{StaticResource TileChromeStyle}"
                    Width="{Binding TileWidth}" Height="{Binding TileHeight}"
                    Tag="{Binding}" Focusable="True"
                    AutomationProperties.Name="{Binding Name}"
                    PreviewMouseLeftButtonDown="Tile_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="Tile_MouseLeftButtonUp"
                    PreviewKeyDown="Tile_PreviewKeyDown">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource TileAppearanceBrush}">
                        <Binding Path="Accent" />
                        <Binding Path="VisualStyle" />
                    </MultiBinding>
                </Border.Background>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource TileContextMenuStyle}"
                                 Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                        <ContextMenu.Resources>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource TileMenuItemStyle}" />
                            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource TileMenuSeparatorStyle}" />
                        </ContextMenu.Resources>
                        <MenuItem Header="调整大小">
                            <MenuItem Header="小" Tag="size:Small" IsCheckable="True" Click="ResizeTile_Click" />
                            <MenuItem Header="中" Tag="size:Medium" IsCheckable="True" Click="ResizeTile_Click" />
                            <MenuItem Header="宽" Tag="size:Wide" IsCheckable="True" Click="ResizeTile_Click" />
                            <MenuItem Header="大" Tag="size:Large" IsCheckable="True" Click="ResizeTile_Click" />
                        </MenuItem>
                        <MenuItem Header="磁贴颜色">
                            <MenuItem Tag="color:#176BC2" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#176BC2" Margin="0,0,9,0" /><TextBlock Text="海蓝" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#0E7894" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#0E7894" Margin="0,0,9,0" /><TextBlock Text="青蓝" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#21806D" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#21806D" Margin="0,0,9,0" /><TextBlock Text="松绿" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#C58B2A" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#C58B2A" Margin="0,0,9,0" /><TextBlock Text="琥珀" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#C55A24" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#C55A24" Margin="0,0,9,0" /><TextBlock Text="暖橙" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#B4473D" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#B4473D" Margin="0,0,9,0" /><TextBlock Text="砖红" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#7651A8" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#7651A8" Margin="0,0,9,0" /><TextBlock Text="暮紫" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="color:#33465A" IsCheckable="True" Click="TileColor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="3" Background="#33465A" Margin="0,0,9,0" /><TextBlock Text="石墨" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="自定义颜色…" Click="CustomTileColor_Click" />
                        </MenuItem>
                        <MenuItem Header="磁贴风格">
                            <MenuItem Header="通透玻璃" Tag="style:Glass" IsCheckable="True" Click="TileStyle_Click" />
                            <MenuItem Header="经典纯色" Tag="style:Classic" IsCheckable="True" Click="TileStyle_Click" />
                            <MenuItem Header="极简深色" Tag="style:Minimal" IsCheckable="True" Click="TileStyle_Click" />
                            <MenuItem Header="仅显示图标" Tag="style:IconOnly" IsCheckable="True" Click="TileStyle_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="打开/关闭动态磁贴" Click="ToggleLiveTile_Click" />
                        <MenuItem Header="从开始屏幕取消固定" Click="UnpinTile_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="TileBody">
                    <Border x:Name="GlassOverlay" IsHitTestVisible="False" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#32FFFFFF" Offset="0" />
                                <GradientStop Color="#08FFFFFF" Offset="0.42" />
                                <GradientStop Color="#22000000" Offset="0.76" />
                                <GradientStop Color="#3A000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border x:Name="LabelContrastScrim" Height="82" VerticalAlignment="Bottom"
                            IsHitTestVisible="False" CornerRadius="0,0,9,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#24000000" Offset="0.42" />
                                <GradientStop Color="#59000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid x:Name="AppTileContent" Margin="12">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:TileKind.Clock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="AppIconHost">
                            <Image x:Name="AppIcon" Source="{Binding Icon}" Width="52" Height="52" Stretch="Uniform"
                                   Visibility="{Binding Icon, Converter={StaticResource IconVisible}}" />
                            <TextBlock x:Name="AppGlyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="45"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource GlyphVisible}}" />
                        </Grid>
                        <TextBlock x:Name="AppName" Grid.Row="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0" VerticalAlignment="Bottom" />
                    </Grid>

                    <Grid x:Name="ClockTileContent" Margin="14">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:TileKind.Clock}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="{Binding LivePrimaryText}" FontWeight="Light"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.FontSize>
                                <MultiBinding Converter="{StaticResource ClockFontSize}">
                                    <Binding Path="TileWidth" />
                                    <Binding Path="TileHeight" />
                                </MultiBinding>
                            </TextBlock.FontSize>
                        </TextBlock>
                        <StackPanel x:Name="ClockInfo" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding LiveSecondaryText}">
                                <TextBlock.FontSize>
                                    <MultiBinding Converter="{StaticResource ClockFontSize}" ConverterParameter="Detail">
                                        <Binding Path="TileWidth" />
                                        <Binding Path="TileHeight" />
                                    </MultiBinding>
                                </TextBlock.FontSize>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" Foreground="#CCFFFFFF">
                                <TextBlock.FontSize>
                                    <MultiBinding Converter="{StaticResource ClockFontSize}" ConverterParameter="Detail">
                                        <Binding Path="TileWidth" />
                                        <Binding Path="TileHeight" />
                                    </MultiBinding>
                                </TextBlock.FontSize>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Thumb x:Name="ResizeHandle" Width="32" Height="32" Opacity="0.07"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                           ToolTip="拖动按网格调整大小 · 按住 Alt 无级调整"
                           DragStarted="ResizeHandle_DragStarted" DragDelta="ResizeHandle_DragDelta"
                           DragCompleted="ResizeHandle_DragCompleted"
                           PreviewMouseLeftButtonDown="ResizeHandle_PreviewMouseLeftButtonDown">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M 8,21 L 21,8 M 14,21 L 21,14"
                                          Stroke="#E8F7FCFF" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ResizeHandle" Property="Opacity" Value="0.94" />
                </Trigger>
                <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ResizeHandle" Property="Opacity" Value="0.78" />
                </Trigger>
                <DataTrigger Binding="{Binding VisualStyle}" Value="{x:Static models:TileVisualStyle.Classic}">
                    <Setter TargetName="GlassOverlay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Tile" Property="CornerRadius" Value="4" />
                    <Setter TargetName="LabelContrastScrim" Property="CornerRadius" Value="0,0,4,4" />
                    <Setter TargetName="Tile" Property="Effect" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualStyle}" Value="{x:Static models:TileVisualStyle.Minimal}">
                    <Setter TargetName="GlassOverlay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Tile" Property="Effect" Value="{x:Null}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#528EC6DE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualStyle}" Value="{x:Static models:TileVisualStyle.IconOnly}">
                    <Setter TargetName="GlassOverlay" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LabelContrastScrim" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppIcon" Property="Width" Value="72" />
                    <Setter TargetName="AppIcon" Property="Height" Value="72" />
                    <Setter TargetName="AppGlyph" Property="FontSize" Value="58" />
                    <Setter TargetName="AppTileContent" Property="Margin" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Size}" Value="{x:Static models:TileSize.Small}">
                    <Setter TargetName="LabelContrastScrim" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppName" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppIcon" Property="Width" Value="32" />
                    <Setter TargetName="AppIcon" Property="Height" Value="32" />
                    <Setter TargetName="AppGlyph" Property="FontSize" Value="31" />
                    <Setter TargetName="AppTileContent" Property="Margin" Value="8" />
                    <Setter TargetName="ClockInfo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AppListTemplate" DataType="{x:Type models:LauncherItem}">
            <Border Padding="10,7" CornerRadius="6" Background="Transparent"
                    Loaded="AppListItem_Loaded" DataContextChanged="AppListItem_DataContextChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <Image Source="{Binding Icon}" Stretch="Uniform"
                               Visibility="{Binding Icon, Converter={StaticResource IconVisible}}" />
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={StaticResource GlyphVisible}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               FontSize="14" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" ToolTip="{Binding PinActionToolTip}"
                            Width="32" Height="32" FontSize="15" Tag="{Binding}" Click="PinApp_Click"
                            AutomationProperties.Name="{Binding PinActionAccessibleName}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Content" Value="&#xE718;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="&#xE73E;" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="LauncherRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="LauncherScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="LauncherTranslate" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#FF0A1A2E" Offset="0" />
                <GradientStop Color="#FF0D2A46" Offset="0.52" />
                <GradientStop Color="#FF123D5B" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="940" Height="940" Canvas.Right="-270" Canvas.Top="-530"
                     Stroke="#22C4EEFF" StrokeThickness="1">
                <Ellipse.Effect><BlurEffect Radius="2" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="720" Height="720" Canvas.Right="130" Canvas.Bottom="-510"
                     Stroke="#155CA6DA" StrokeThickness="1">
                <Ellipse.Effect><BlurEffect Radius="3" /></Ellipse.Effect>
            </Ellipse>
            <Path Data="M 780,-80 L 1160,-80 L 660,900 L 490,900 Z" Fill="#0F8FD8FF">
                <Path.Effect><BlurEffect Radius="18" /></Path.Effect>
            </Path>
        </Canvas>

        <Border Grid.Column="0" Background="#78101F31" BorderBrush="#24DDF3FF" BorderThickness="0,0,1,0">
            <Border.Effect><DropShadowEffect Color="#020912" BlurRadius="24" ShadowDepth="6" Opacity="0.28" /></Border.Effect>
            <Grid Margin="0,24,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="19" Background="#2FD8ECFF"
                            BorderBrush="#72EAF7FF" BorderThickness="1" Margin="0,0,0,8">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UserNameText" Style="{StaticResource RailLabelStyle}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button x:Name="PinnedNavigationButton" Content="&#xE80F;" Tag="Selected"
                            ToolTip="固定的磁贴" AutomationProperties.Name="固定的磁贴"
                            Style="{StaticResource NavButtonStyle}" Click="PinnedTiles_Click" />
                    <Button x:Name="AppsNavigationButton" Content="&#xE71D;"
                            ToolTip="所有应用与搜索" AutomationProperties.Name="所有应用与搜索"
                            Style="{StaticResource NavButtonStyle}" Click="AllApps_Click" />
                    <Button Content="&#xE8B7;" ToolTip="文件资源管理器" AutomationProperties.Name="打开文件资源管理器"
                            Style="{StaticResource IconButtonStyle}" Click="Explorer_Click" />
                    <Button Content="&#xE713;" ToolTip="Windows 设置" AutomationProperties.Name="打开 Windows 设置"
                            Style="{StaticResource IconButtonStyle}" Click="Settings_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="PowerButton" Content="&#xE7E8;" ToolTip="电源" AutomationProperties.Name="电源选项"
                            Style="{StaticResource IconButtonStyle}" Click="Power_Click" />
                    <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=PowerButton}" Placement="Right"
                           AllowsTransparency="True" StaysOpen="False" Opened="Popup_Opened" Closed="Popup_Closed">
                        <Border BorderBrush="#76DDF3FF" BorderThickness="1"
                                CornerRadius="12" Padding="8" Margin="9,0,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FA102A42" Offset="0" />
                                    <GradientStop Color="#F20A1C30" Offset="0.58" />
                                    <GradientStop Color="#FA071625" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#000711" BlurRadius="28" ShadowDepth="9" Opacity="0.58" /></Border.Effect>
                            <StackPanel Width="210">
                                <StackPanel Orientation="Horizontal" Margin="10,6,8,7">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="#CDECF8FF" Width="28" VerticalAlignment="Center" />
                                    <TextBlock Text="电源选项" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#F5FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="开机自动运行"
                                          Style="{StaticResource PowerToggleStyle}" Click="StartWithWindows_Click" />
                                <Separator Style="{StaticResource PowerSeparatorStyle}" />
                                <Button Tag="sleep" Click="PowerAction_Click" Style="{StaticResource PowerActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" />
                                        <TextBlock Text="睡眠" FontSize="14" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="restart" Click="PowerAction_Click" Style="{StaticResource PowerActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" />
                                        <TextBlock Text="重新启动" FontSize="14" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="shutdown" Click="PowerAction_Click" Style="{StaticResource PowerActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" />
                                        <TextBlock Text="关机" FontSize="14" />
                                    </StackPanel>
                                </Button>
                                <Separator Style="{StaticResource PowerSeparatorStyle}" />
                                <Button Tag="exit" Click="PowerAction_Click" Style="{StaticResource PowerActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" />
                                        <TextBlock Text="退出 Tile10" FontSize="14" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="40,20,42,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="开始" FontSize="32" FontWeight="Light" VerticalAlignment="Center" />
                    <TextBlock x:Name="PageSubtitleText" Text="你的空间，按你的方式排列" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" Margin="18,10,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DateText" Grid.Column="1" FontSize="14"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,0,0" />
            </Grid>

            <Grid x:Name="ContentHost" Grid.Row="1">
                <ScrollViewer x:Name="TilesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               PanningMode="Both" PreviewMouseWheel="TilesScroll_PreviewMouseWheel"
                               Margin="32,0,26,0">
                    <ScrollViewer.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource GlassScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="TilesItems" ItemTemplate="{StaticResource TileTemplate}">
                        <ItemsControl.LayoutTransform>
                            <ScaleTransform x:Name="TilesZoomTransform" ScaleX="1" ScaleY="1" />
                        </ItemsControl.LayoutTransform>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="controls:TilePositionPanel.Column" Value="{Binding GridColumn}" />
                                <Setter Property="controls:TilePositionPanel.Row" Value="{Binding GridRow}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TilePositionPanel Background="Transparent" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel Margin="0,0,34,16">
                                                        <Grid Height="34">
                                                            <TextBox Text="{Binding Name, Mode=OneWay}" Tag="{Binding Name}"
                                                                     FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="Normal"
                                                                     Margin="1,0,30,9" Padding="4,1" Foreground="#F0F5FAFF"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     ToolTip="单击可重命名分组"
                                                                     AutomationProperties.Name="{Binding Name, StringFormat=分组名称：{0}}"
                                                                     LostKeyboardFocus="GroupName_LostKeyboardFocus"
                                                                     PreviewKeyDown="GroupName_PreviewKeyDown" />
                                                            <Thumb Width="32" Height="32" Margin="0,0,0,0"
                                                                   Tag="{Binding Name}"
                                                                   Focusable="True"
                                                                   FocusVisualStyle="{StaticResource KeyboardFocusVisualStyle}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Cursor="SizeNWSE" ToolTip="拖动或使用方向键调整分组宽高"
                                                                   AutomationProperties.Name="{Binding Name, StringFormat=调整分组大小：{0}}"
                                                                   AutomationProperties.HelpText="左右方向键调整列数，上下方向键调整行数"
                                                                   PreviewKeyDown="GroupResize_PreviewKeyDown"
                                                                   DragStarted="GroupResize_DragStarted"
                                                                   DragDelta="GroupResize_DragDelta"
                                                                   DragCompleted="GroupResize_DragCompleted">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border x:Name="GroupResizeChrome" Opacity="0.52"
                                                                                Background="#18000000" BorderBrush="#45D9F3FF"
                                                                                BorderThickness="1" CornerRadius="4">
                                                                            <Grid>
                                                                                <Path Data="M 8,15 L 15,8 M 11,17 L 17,11"
                                                                                      Stroke="#D7ECF8FF" StrokeThickness="1.4"
                                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                             </Grid>
                                                                         </Border>
                                                                         <ControlTemplate.Triggers>
                                                                             <Trigger Property="IsMouseOver" Value="True">
                                                                                 <Setter TargetName="GroupResizeChrome" Property="Opacity" Value="0.9" />
                                                                             </Trigger>
                                                                             <Trigger Property="IsDragging" Value="True">
                                                                                 <Setter TargetName="GroupResizeChrome" Property="Opacity" Value="1" />
                                                                             </Trigger>
                                                                         </ControlTemplate.Triggers>
                                                                     </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Grid>
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <controls:GroupPositionPanel Background="Transparent" />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="PinnedEmptyState" Panel.ZIndex="2" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="34,28" CornerRadius="14"
                        Background="#B20A2034" BorderBrush="#4FDDF3FF" BorderThickness="1">
                    <StackPanel Width="330" HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Center"
                                Background="#2E75BCE5" BorderBrush="#72DDF3FF" BorderThickness="1">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="这里还没有固定的磁贴" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,7" />
                        <TextBlock Text="从所有应用中选择常用项目，把开始屏幕布置成你的工作空间。"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   TextWrapping="Wrap" LineHeight="20" />
                        <Button Content="浏览所有应用" Style="{StaticResource PrimaryActionButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,20,0,0" Click="AllApps_Click"
                                AutomationProperties.Name="浏览所有应用并固定磁贴" />
                    </StackPanel>
                </Border>

                <Border x:Name="AppsPanel"
                        Width="{Binding ActualWidth, ElementName=ContentHost, Converter={StaticResource DrawerWidth}}"
                        Margin="32,0,0,8"
                        HorizontalAlignment="Left" Panel.ZIndex="10"
                        Background="#F20A1C2E" BorderBrush="#58DDF3FF" BorderThickness="1" CornerRadius="10"
                        Visibility="Collapsed" SizeChanged="AppsPanel_SizeChanged">
                    <Grid Margin="10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="AppsPanelTitle" Text="所有应用" FontSize="24" FontWeight="Light" VerticalAlignment="Center" Margin="8,0" />
                            <TextBlock x:Name="AppsCountText" Text="应用"
                                       FontSize="13" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="126,5,48,0" />
                            <Button Content="&#xE711;" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    Width="38" Height="38" Click="CloseApps_Click" ToolTip="关闭所有应用"
                                    AutomationProperties.Name="关闭所有应用" />
                        </Grid>
                        <Grid x:Name="SearchHost" Grid.Row="1" Height="50" Margin="8,2,8,12"
                              VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Margin="17,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Panel.ZIndex="2" />
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}"
                                     FontSize="18" Padding="50,12,48,12"
                                     AutomationProperties.Name="搜索应用"
                                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                            <TextBlock x:Name="SearchHint" Text="搜索应用名称" Foreground="#AFFFFFFF" FontSize="17"
                                       Margin="50,0,48,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Panel.ZIndex="2" />
                            <Button x:Name="ClearSearchButton" Content="&#xE711;" ToolTip="清除搜索"
                                     Style="{StaticResource IconButtonStyle}" Width="36" Height="36" FontSize="14"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                                     Visibility="Collapsed" Click="ClearSearch_Click" Panel.ZIndex="3"
                                     AutomationProperties.Name="清除搜索" />
                        </Grid>
                        <ListBox x:Name="AppsList" Grid.Row="2" HorizontalAlignment="Stretch"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" ItemTemplate="{StaticResource AppListTemplate}"
                                 ItemContainerStyle="{StaticResource AppListItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.CacheLength="1,1"
                                  MouseDoubleClick="AppsList_MouseDoubleClick"
                                  PreviewKeyDown="AppsList_PreviewKeyDown"
                                  AutomationProperties.Name="应用列表">
                            <ListBox.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource GlassScrollBarStyle}" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                            </ListBox.Resources>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Light"
                                                       Foreground="#BFFFFFFF" Margin="5,14,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        <StackPanel x:Name="EmptySearchState" Grid.Row="2" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False" Margin="28">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                       Foreground="#BFDDF3FF" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptySearchTitle" Text="没有找到匹配的应用"
                                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,15,0,6" />
                            <TextBlock x:Name="EmptySearchDescription" Text="尝试更短的名称或检查拼写"
                                       FontSize="13" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LoadingPanel" Background="#D00A2034" BorderBrush="#42DDF3FF" BorderThickness="1"
                        CornerRadius="10" Padding="24,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="70" Height="4" IsIndeterminate="True" Margin="0,0,16,0" />
                        <TextBlock Text="正在整理你的应用…" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="38,0,38,12">
                <TextBlock Text="拖动与拉伸自动吸附网格 · Alt + 拉伸可无级调节 · 拖到右侧可新建分组" FontSize="12"
                           Foreground="#7FFFFFFF" VerticalAlignment="Bottom" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Border x:Name="StatusToast" Visibility="Collapsed" Margin="0,0,12,-4"
                            Padding="11,7" CornerRadius="8" MaxWidth="520"
                            Background="#E6122C42" BorderBrush="#70DDF3FF" BorderThickness="1"
                            MouseEnter="StatusToast_MouseEnter" MouseLeave="StatusToast_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#D8F5FCFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" Foreground="#F2FFFFFF"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MaxWidth="390"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="StatusActionButton" Grid.Column="2" Content="撤销" Visibility="Collapsed"
                                    Style="{StaticResource ZoomResetButtonStyle}" Margin="10,0,0,0"
                                    Padding="8,2" Click="UndoUnpin_Click"
                                    GotKeyboardFocus="StatusActionButton_GotKeyboardFocus"
                                    LostKeyboardFocus="StatusActionButton_LostKeyboardFocus"
                                    AutomationProperties.Name="撤销取消固定" />
                        </Grid>
                    </Border>
                    <Border Width="1" Height="12" Background="#38DDF3FF" Margin="0,0,12,0" />
                    <Button x:Name="ZoomResetButton" Style="{StaticResource ZoomResetButtonStyle}"
                            ToolTip="点击恢复 100%" Click="ZoomReset_Click"
                            AutomationProperties.Name="将画布缩放重置为 100%">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="ZoomText" Text="100% · Ctrl + 滚轮缩放" FontSize="12"
                                       Foreground="{Binding Foreground, ElementName=ZoomResetButton}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Canvas x:Name="DragLayer" Grid.ColumnSpan="2" Panel.ZIndex="1000" IsHitTestVisible="False">
            <Border x:Name="DropSlotPreview" Visibility="Collapsed" Opacity="0.72"
                    CornerRadius="10" Background="#1EDDF6FF"
                    BorderBrush="#D9F4FCFF" BorderThickness="2" />
            <Border x:Name="DragPreview" Visibility="Collapsed" Opacity="0.9"
                    CornerRadius="10" BorderBrush="#B8F4FBFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000713" BlurRadius="30" ShadowDepth="12" Opacity="0.58" />
                </Border.Effect>
            </Border>
        </Canvas>
    </Grid>
</Window>
